# ───────── REQUIRED ─────────
# Local MongoDB:  mongodb://127.0.0.1:27017/offcut
# Atlas (free):   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/offcut
MONGODB_URI=mongodb://127.0.0.1:27017/offcut

# Any long random string. Generate with:  npx auth secret   (or)   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# App URL (local only)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# UploadThing (free tier) — https://uploadthing.com/dashboard → API Keys → copy the V7 token
# Without it the app runs, but upload widgets are replaced by "paste an image URL" fields.
UPLOADTHING_TOKEN=

# ───────── OPTIONAL ─────────
# Google login (only enabled when both are set). Callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Razorpay TEST MODE keys (rzp_test_...). Without them, only Cash on Delivery is offered.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Only used by the optional /api/webhooks/razorpay route (not needed for localhost demo)
RAZORPAY_WEBHOOK_SECRET=

# Email via Nodemailer (Gmail app password / Mailtrap). If empty, emails go to an
# Ethereal test inbox (preview link printed in the terminal) or, offline, to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="OFFCUT <no-reply@offcut.test>"
